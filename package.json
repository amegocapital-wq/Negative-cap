{
  "name": "hookline",
  "private": true,
  "version": "1.0.0",
  "description": "Hookline \u2014 turn long-form video transcripts into scroll-stopping short-form clips.",
  "type": "module",
  "scripts": {
    "android:add": "npx cap add android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:sync": "npm run build:standalone && npx cap sync android",
    "build": "tsc --noEmit && vite build",
    "build:standalone": "tsc --noEmit && vite build --config vite.standalone.config.ts",
    "check": "npm run engine:check && npm run ui:smoke && npm run standalone:check",
    "dev": "vite --host 0.0.0.0",
    "engine:check": "esbuild tools/engine-check.ts --bundle --platform=node --format=esm --outfile=.engine-check.mjs && node .engine-check.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "serve": "node tools/serve-standalone.mjs",
    "standalone:check": "node tools/standalone-check.mjs",
    "ui:smoke": "esbuild tools/ui-smoke.tsx --bundle --platform=node --format=esm --external:jsdom --outfile=.ui-smoke.mjs --loader:.css=empty && node .ui-smoke.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/clipboard": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/share": "^6.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.24.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "engines": {
    "node": ">=22.19"
  }
}
